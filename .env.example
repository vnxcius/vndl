# Copy to .env in the repo root (next to docker-compose.yml) — Compose reads
# it automatically. Every line is optional; the values shown are the defaults.

# --- Host / Docker ---
# Host port for the frontend (Caddy), and the interface it's published on.
# Keep loopback when cloudflared runs on this host; 0.0.0.0 only if it runs
# elsewhere and the port is firewalled to it (the backend trusts CF-Connecting-IP).
FRONTEND_PORT=8081
FRONTEND_BIND=127.0.0.1
# Only used by docker-compose.override.yml for direct local debugging.
BACKEND_PORT=8080
# Backend container limits.
BACKEND_MEM_LIMIT=2g
BACKEND_CPUS=2
# Host directory for log files; must be writable by UID 1000.
LOGS_DIR=./logs

# --- Backend ---
# CORS allow-list, comma-separated. Not needed in production: Caddy serves
# the frontend and API on the same origin.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# Per-client token bucket: sustained requests/second and burst size.
RATE_LIMIT_RPS=1
RATE_LIMIT_BURST=5
# Server-wide cap on concurrent yt-dlp/ffmpeg processes, and how long a
# request waits for a free slot before getting a 503.
MAX_CONCURRENT_YTDLP=6
CONCURRENCY_MAX_WAIT=15s
# Per-download bounds. 0 disables MAX_JOBS_PER_IP / MAX_JOB_DURATION.
MAX_JOBS_PER_IP=2
MAX_JOB_DURATION=30m
MAX_FILESIZE=2G
# Server-wide cap on open progress (SSE) streams; 0 disables.
MAX_SSE_CONNECTIONS=512
# How long a job stays queryable, and how long probe results are cached (0 disables).
JOB_TTL=5m
PROBE_CACHE_TTL=10m
# text (color-accented) or json.
LOG_FORMAT=text
LOG_RETENTION_DAYS=30
