# Copy to .env — read by docker-compose.yml (Compose loads .env from the
# project root automatically). Host ports published for each service.
BACKEND_PORT=8080
FRONTEND_PORT=8081
# Interface Caddy is published on; keep loopback when cloudflared runs on this host.
FRONTEND_BIND=127.0.0.1
BACKEND_MEM_LIMIT=2g
BACKEND_CPUS=2
